# Copy to .env.local and fill in. Every value is validated at startup
# (src/lib/env/schema.ts); later phases add R2 and link-token secrets.

# Public URL of this deployment, no trailing slash.
APP_URL=http://localhost:3000

# Atlas dev cluster connection string (Mumbai, ap-south-1). Use a database user
# limited to the database below.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=mmm

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Signs sessions and tokens; at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a different value in each environment. Changing it signs everyone out.
BETTER_AUTH_SECRET=

# Derives guests' personal RSVP links (and later gallery links). At least 32
# characters, different per environment. Changing it breaks every link already
# sent on WhatsApp, so set it once.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_SECRET=

# Resend API key (https://resend.com/api-keys). Optional: without it, password
# reset links are printed in the dev server log instead of emailed. With no
# verified domain, Resend only delivers to your own Resend account email.
RESEND_API_KEY=
EMAIL_FROM=Make My Marriage <onboarding@resend.dev>
