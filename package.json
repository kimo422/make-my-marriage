{
  "name": "make-my-marriage",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "db:migrate": "migrate-mongo up -f migrate-mongo-config.cjs",
    "db:migrate:status": "migrate-mongo status -f migrate-mongo-config.cjs",
    "db:migrate:create": "migrate-mongo create -f migrate-mongo-config.cjs",
    "prepare": "husky",
    "lockfile:check": "node scripts/check-lockfile.mjs"
  },
  "dependencies": {
    "better-auth": "^1.7.12",
    "mongodb": "~7.7.0",
    "mongoose": "^9.11.2",
    "next": "16.4.2",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "migrate-mongo": "^14.0.7",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write",
    "package-lock.json": "node scripts/check-lockfile.mjs"
  }
}
